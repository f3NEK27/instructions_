<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Multichannel_Autoapproval"
  targetNamespace="http://example.org/insurance/autoapproval/multichannel">
  <process id="Process_Multichannel_Autoapproval" name="Техническая схема автосогласования медуслуг: МП, почта, интеграция" isExecutable="false">
    <documentation>Проверки выполняются для каждой услуги. Первая непройденная проверка формирует отказ по этой услуге. Для СпецДМС IMAN рассчитывает лимит: при доступном лимите обработка продолжается, при исчерпанном формируется отказ. Сочетание красный клиент + красное ЛПУ не прерывает обработку агентом: устанавливается флаг повышенного внимания, а при согласовании услуги в АИС выводится специальная пометка сотруднику. Результат по каждой услуге записывается в поля вкладки «УСЛУГИ ЭП». После корректировки сотрудником весь набор проверок запускается повторно.</documentation>

    <laneSet id="LaneSet_Main">
      <lane id="Lane_Channels" name="Каналы входа">
        <flowNodeRef>Start_Request</flowNodeRef>
        <flowNodeRef>Gateway_Channel</flowNodeRef>
        <flowNodeRef>Receive_Mobile</flowNodeRef>
        <flowNodeRef>Receive_Email</flowNodeRef>
        <flowNodeRef>Receive_Integration</flowNodeRef>
        <flowNodeRef>Gateway_Documents_Merge</flowNodeRef>
      </lane>
      <lane id="Lane_Orchestrator" name="Сервис-оркестратор / API">
        <flowNodeRef>Send_To_IngoRead</flowNodeRef>
        <flowNodeRef>Receive_Integration_JSON</flowNodeRef>
        <flowNodeRef>Gateway_JSON_Merge</flowNodeRef>
        <flowNodeRef>Validate_Normalize_JSON</flowNodeRef>
        <flowNodeRef>Call_Oracle</flowNodeRef>
        <flowNodeRef>Gateway_Franchise</flowNodeRef>
        <flowNodeRef>Call_IMAN</flowNodeRef>
        <flowNodeRef>Gateway_Output_Merge</flowNodeRef>
        <flowNodeRef>Build_Output_JSON</flowNodeRef>
        <flowNodeRef>Resend_To_Agent</flowNodeRef>
      </lane>
      <lane id="Lane_AIS" name="АИС">
        <flowNodeRef>AIS_Upsert_Case</flowNodeRef>
        <flowNodeRef>AIS_Save_EP</flowNodeRef>
      </lane>
      <lane id="Lane_IngoRead" name="IngoRead">
        <flowNodeRef>IngoRead_OCR</flowNodeRef>
        <flowNodeRef>IngoRead_Build_JSON</flowNodeRef>
      </lane>
      <lane id="Lane_Oracle" name="Oracle">
        <flowNodeRef>Oracle_Check_Franchise</flowNodeRef>
      </lane>
      <lane id="Lane_IMAN" name="IMAN / агент / базы знаний">
        <flowNodeRef>IMAN_LPU_Mode</flowNodeRef>
        <flowNodeRef>IMAN_Check_SpecialDMS</flowNodeRef>
        <flowNodeRef>Gateway_SpecialDMS</flowNodeRef>
        <flowNodeRef>IMAN_Check_Color</flowNodeRef>
        <flowNodeRef>Gateway_Color</flowNodeRef>
        <flowNodeRef>IMAN_Check_Program</flowNodeRef>
        <flowNodeRef>Gateway_Program</flowNodeRef>
        <flowNodeRef>IMAN_Check_Risks</flowNodeRef>
        <flowNodeRef>Gateway_Risk</flowNodeRef>
        <flowNodeRef>IMAN_Calc_Limit</flowNodeRef>
        <flowNodeRef>Gateway_Limit</flowNodeRef>
        <flowNodeRef>IMAN_Check_Protocol_Age</flowNodeRef>
        <flowNodeRef>Gateway_Protocol_Age</flowNodeRef>
        <flowNodeRef>IMAN_Check_Exclusions</flowNodeRef>
        <flowNodeRef>Gateway_Exclusions</flowNodeRef>
        <flowNodeRef>IMAN_Check_Clinical</flowNodeRef>
        <flowNodeRef>Gateway_Clinical</flowNodeRef>
        <flowNodeRef>IMAN_Medical_Expertise</flowNodeRef>
        <flowNodeRef>IMAN_Build_Refusal</flowNodeRef>
        <flowNodeRef>IMAN_Set_Attention_Flag</flowNodeRef>
      </lane>
      <lane id="Lane_Employee" name="Сотрудник сопровождения / ручной контроль">
        <flowNodeRef>Employee_Review</flowNodeRef>
        <flowNodeRef>Gateway_Correction</flowNodeRef>
        <flowNodeRef>Employee_Edit_Request</flowNodeRef>
        <flowNodeRef>End_Processed</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="Start_Request" name="Поступило обращение" />
    <exclusiveGateway id="Gateway_Channel" name="Канал входа?" />
    <receiveTask id="Receive_Mobile" name="МП: обращение с протоколом">
      <documentation>Мобильное приложение передает обращение и файл медицинского протокола.</documentation>
    </receiveTask>
    <receiveTask id="Receive_Email" name="Почта: обращение с протоколом">
      <documentation>Почтовое обращение без ручной подготовки JSON сразу направляется в IngoRead.</documentation>
    </receiveTask>
    <receiveTask id="Receive_Integration" name="Интеграция: готовые поля JSON">
      <documentation>Интеграционный канал сразу передает структурированные поля. IngoRead не вызывается.</documentation>
    </receiveTask>
    <exclusiveGateway id="Gateway_Documents_Merge" name="Протокол получен" />

    <serviceTask id="Send_To_IngoRead" name="Передать протокол в IngoRead" />
    <serviceTask id="Receive_Integration_JSON" name="Принять JSON по API" />
    <exclusiveGateway id="Gateway_JSON_Merge" name="JSON получен" />
    <serviceTask id="Validate_Normalize_JSON" name="Проверить обязательные поля и нормализовать JSON">
      <documentation>Вход для агента: diagnosis, complaints, services[], lpu.name, lpu.type, lpu.color, client_color, program, program_code, gender, patient_name_patronymic, risks[]. Для выполнения процесса также обязательны request_id, insured_id и protocol_date, если есть протокол.</documentation>
    </serviceTask>
    <serviceTask id="Call_Oracle" name="Запросить проверку франшизы в Oracle" />
    <exclusiveGateway id="Gateway_Franchise" name="Есть задолженность по франшизе?" />
    <serviceTask id="Call_IMAN" name="Передать нормализованный JSON в IMAN" />
    <exclusiveGateway id="Gateway_Output_Merge" name="Решение сформировано" />
    <serviceTask id="Build_Output_JSON" name="Сформировать выходной JSON и пометки по услугам">
      <documentation>Для каждой услуги: service, decision, decision_reason, personalized_refusal_reason. Персонализированный текст используется только при отказе. Если услуга согласована и установлен флаг red client + red LPU, передаются attention_required = true и attention_label = «ОСОБОЕ ВНИМАНИЕ».</documentation>
    </serviceTask>
    <serviceTask id="Resend_To_Agent" name="Повторно передать запрос агенту" />

    <serviceTask id="AIS_Upsert_Case" name="Создать / обновить обращение и сохранить входной JSON" />
    <serviceTask id="AIS_Save_EP" name="Записать ответ и пометки во вкладку «УСЛУГИ ЭП»">
      <documentation>Записывается решение по услуге, обоснование решения и персонализированная причина отказа. Для согласованной услуги с красным клиентом и красным ЛПУ отображается пометка «ОСОБОЕ ВНИМАНИЕ».</documentation>
    </serviceTask>

    <serviceTask id="IngoRead_OCR" name="Распознать медицинский протокол" />
    <serviceTask id="IngoRead_Build_JSON" name="Извлечь и структурировать поля JSON" />

    <businessRuleTask id="Oracle_Check_Franchise" name="Проверить задолженность по франшизе">
      <documentation>Если у застрахованного есть задолженность по франшизе, услуга получает отказ.</documentation>
    </businessRuleTask>

    <businessRuleTask id="IMAN_LPU_Mode" name="Определить тип ЛПУ и режим контроля">
      <documentation>Для lpu.type = special включается признак усиленного внимания при последующих проверках.</documentation>
    </businessRuleTask>
    <businessRuleTask id="IMAN_Check_SpecialDMS" name="Проверить СпецДМС и рассчитать доступный лимит">
      <documentation>Если кейс относится к СпецДМС, IMAN рассчитывает остаток лимита по условиям обслуживания и выбранному ЛПУ. Для обычного ДМС проверка считается неприменимой и процесс продолжается.</documentation>
    </businessRuleTask>
    <exclusiveGateway id="Gateway_SpecialDMS" name="Лимит СпецДМС исчерпан?" />
    <businessRuleTask id="IMAN_Check_Color" name="Проверить цвета клиента и ЛПУ" />
    <exclusiveGateway id="Gateway_Color" name="Нужен флаг повышенного внимания?" />
    <serviceTask id="IMAN_Set_Attention_Flag" name="Установить флаг: красный клиент + красное ЛПУ">
      <documentation>Флаг не останавливает проверки и не переводит кейс к врачу. Если итоговая услуга будет согласована, флаг преобразуется в пометку «ОСОБОЕ ВНИМАНИЕ» для сотрудника.</documentation>
    </serviceTask>
    <businessRuleTask id="IMAN_Check_Program" name="Проверить доступность услуги по программе" />
    <exclusiveGateway id="Gateway_Program" name="Услуга доступна?" />
    <businessRuleTask id="IMAN_Check_Risks" name="Проверить услугу по рискам застрахованного" />
    <exclusiveGateway id="Gateway_Risk" name="Результат проверки риска?" />
    <businessRuleTask id="IMAN_Calc_Limit" name="Рассчитать количественное ограничение">
      <documentation>Пример: проверить использованное количество массажей относительно лимита 20 в год.</documentation>
    </businessRuleTask>
    <exclusiveGateway id="Gateway_Limit" name="Лимит не исчерпан?" />
    <businessRuleTask id="IMAN_Check_Protocol_Age" name="Проверить срок медицинского протокола" />
    <exclusiveGateway id="Gateway_Protocol_Age" name="Протокол не старше 30 дней?" />
    <businessRuleTask id="IMAN_Check_Exclusions" name="Проверить исключения из программы" />
    <exclusiveGateway id="Gateway_Exclusions" name="Услуга в исключениях?" />
    <businessRuleTask id="IMAN_Check_Clinical" name="Проверить клинические рекомендации">
      <documentation>Проверяются медицинская обоснованность и этапность услуги.</documentation>
    </businessRuleTask>
    <exclusiveGateway id="Gateway_Clinical" name="Соответствует клиническим рекомендациям?" />
    <businessRuleTask id="IMAN_Medical_Expertise" name="Провести медэкспертизу и сформировать решение" />
    <serviceTask id="IMAN_Build_Refusal" name="Сформировать отказ по услуге">
      <documentation>Фиксируется непройденная проверка, обоснование и персонализированная причина отказа с именем и отчеством.</documentation>
    </serviceTask>

    <userTask id="Employee_Review" name="Проверить результат и услуги с пометкой в «УСЛУГИ ЭП»" />
    <exclusiveGateway id="Gateway_Correction" name="Нужна корректировка запроса?" />
    <userTask id="Employee_Edit_Request" name="Скорректировать данные запроса" />
    <endEvent id="End_Processed" name="Обработка завершена" />

    <textAnnotation id="Annotation_Input_JSON">
      <text>ВХОД АИС → АГЕНТ
diagnosis; complaints; services[];
lpu { name, type: regular|special, color: red|green };
client_color: red|green; program; program_code; gender;
patient_name_patronymic; risks[];
тех. поля: request_id, insured_id, protocol_date, source</text>
    </textAnnotation>
    <association id="Association_Input" sourceRef="Validate_Normalize_JSON" targetRef="Annotation_Input_JSON" />
    <textAnnotation id="Annotation_Output_JSON">
      <text>ВЫХОД АГЕНТА → «УСЛУГИ ЭП»
services_decision[]:
service; decision;
decision_reason;
personalized_refusal_reason;
attention_required; attention_label — только для согласованной
услуги при красном клиенте + красном ЛПУ</text>
    </textAnnotation>
    <association id="Association_Output" sourceRef="Build_Output_JSON" targetRef="Annotation_Output_JSON" />
    <textAnnotation id="Annotation_Per_Service">
      <text>Все проверки выполняются по каждой услуге.
Первая непройденная проверка → отказ по этой услуге.
Спец ЛПУ → усиленный контроль.
СпецДМС: доступный лимит → дальше; исчерпан → отказ.
Красный клиент + красное ЛПУ → флаг; агент продолжает проверки.</text>
    </textAnnotation>
    <association id="Association_Per_Service" sourceRef="IMAN_LPU_Mode" targetRef="Annotation_Per_Service" />

    <sequenceFlow id="Flow_01" sourceRef="Start_Request" targetRef="Gateway_Channel" />
    <sequenceFlow id="Flow_02" name="МП" sourceRef="Gateway_Channel" targetRef="Receive_Mobile" />
    <sequenceFlow id="Flow_03" name="Почта" sourceRef="Gateway_Channel" targetRef="Receive_Email" />
    <sequenceFlow id="Flow_04" name="Интеграция" sourceRef="Gateway_Channel" targetRef="Receive_Integration" />
    <sequenceFlow id="Flow_05" sourceRef="Receive_Mobile" targetRef="Gateway_Documents_Merge" />
    <sequenceFlow id="Flow_06" sourceRef="Receive_Email" targetRef="Gateway_Documents_Merge" />
    <sequenceFlow id="Flow_07" sourceRef="Gateway_Documents_Merge" targetRef="Send_To_IngoRead" />
    <sequenceFlow id="Flow_08" sourceRef="Receive_Integration" targetRef="Receive_Integration_JSON" />
    <sequenceFlow id="Flow_09" sourceRef="Send_To_IngoRead" targetRef="IngoRead_OCR" />
    <sequenceFlow id="Flow_10" sourceRef="IngoRead_OCR" targetRef="IngoRead_Build_JSON" />
    <sequenceFlow id="Flow_11" sourceRef="IngoRead_Build_JSON" targetRef="Gateway_JSON_Merge" />
    <sequenceFlow id="Flow_12" name="Готовый JSON, без IngoRead" sourceRef="Receive_Integration_JSON" targetRef="Gateway_JSON_Merge" />
    <sequenceFlow id="Flow_13" sourceRef="Gateway_JSON_Merge" targetRef="Validate_Normalize_JSON" />
    <sequenceFlow id="Flow_14" sourceRef="Validate_Normalize_JSON" targetRef="AIS_Upsert_Case" />
    <sequenceFlow id="Flow_15" sourceRef="AIS_Upsert_Case" targetRef="Call_Oracle" />
    <sequenceFlow id="Flow_16" sourceRef="Call_Oracle" targetRef="Oracle_Check_Franchise" />
    <sequenceFlow id="Flow_17" sourceRef="Oracle_Check_Franchise" targetRef="Gateway_Franchise" />
    <sequenceFlow id="Flow_18" name="Да → отказ" sourceRef="Gateway_Franchise" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_19" name="Нет" sourceRef="Gateway_Franchise" targetRef="Call_IMAN" />
    <sequenceFlow id="Flow_20" sourceRef="Call_IMAN" targetRef="IMAN_LPU_Mode" />
    <sequenceFlow id="Flow_21" sourceRef="IMAN_LPU_Mode" targetRef="IMAN_Check_SpecialDMS" />
    <sequenceFlow id="Flow_22" sourceRef="IMAN_Check_SpecialDMS" targetRef="Gateway_SpecialDMS" />
    <sequenceFlow id="Flow_23" name="Да, лимит исчерпан → отказ" sourceRef="Gateway_SpecialDMS" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_24" name="Нет / лимит доступен / не СпецДМС" sourceRef="Gateway_SpecialDMS" targetRef="IMAN_Check_Color" />
    <sequenceFlow id="Flow_25" sourceRef="IMAN_Check_Color" targetRef="Gateway_Color" />
    <sequenceFlow id="Flow_26" name="Да → установить флаг" sourceRef="Gateway_Color" targetRef="IMAN_Set_Attention_Flag" />
    <sequenceFlow id="Flow_27" name="Нет" sourceRef="Gateway_Color" targetRef="IMAN_Check_Program" />
    <sequenceFlow id="Flow_28" sourceRef="IMAN_Check_Program" targetRef="Gateway_Program" />
    <sequenceFlow id="Flow_29" name="Нет → отказ" sourceRef="Gateway_Program" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_30" name="Да" sourceRef="Gateway_Program" targetRef="IMAN_Check_Risks" />
    <sequenceFlow id="Flow_31" sourceRef="IMAN_Check_Risks" targetRef="Gateway_Risk" />
    <sequenceFlow id="Flow_32" name="Входит: прямой отказ" sourceRef="Gateway_Risk" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_33" name="Не входит" sourceRef="Gateway_Risk" targetRef="IMAN_Check_Protocol_Age" />
    <sequenceFlow id="Flow_34" name="Сложный количественный риск" sourceRef="Gateway_Risk" targetRef="IMAN_Calc_Limit" />
    <sequenceFlow id="Flow_35" sourceRef="IMAN_Calc_Limit" targetRef="Gateway_Limit" />
    <sequenceFlow id="Flow_36" name="Нет → отказ" sourceRef="Gateway_Limit" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_37" name="Да" sourceRef="Gateway_Limit" targetRef="IMAN_Check_Protocol_Age" />
    <sequenceFlow id="Flow_38" sourceRef="IMAN_Check_Protocol_Age" targetRef="Gateway_Protocol_Age" />
    <sequenceFlow id="Flow_39" name="Нет, более 30 дней → отказ" sourceRef="Gateway_Protocol_Age" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_40" name="Да / протокол не требуется" sourceRef="Gateway_Protocol_Age" targetRef="IMAN_Check_Exclusions" />
    <sequenceFlow id="Flow_41" sourceRef="IMAN_Check_Exclusions" targetRef="Gateway_Exclusions" />
    <sequenceFlow id="Flow_42" name="Да → отказ" sourceRef="Gateway_Exclusions" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_43" name="Нет" sourceRef="Gateway_Exclusions" targetRef="IMAN_Check_Clinical" />
    <sequenceFlow id="Flow_44" sourceRef="IMAN_Check_Clinical" targetRef="Gateway_Clinical" />
    <sequenceFlow id="Flow_45" name="Нет → отказ" sourceRef="Gateway_Clinical" targetRef="IMAN_Build_Refusal" />
    <sequenceFlow id="Flow_46" name="Да" sourceRef="Gateway_Clinical" targetRef="IMAN_Medical_Expertise" />
    <sequenceFlow id="Flow_47" sourceRef="IMAN_Medical_Expertise" targetRef="Gateway_Output_Merge" />
    <sequenceFlow id="Flow_48" name="Продолжить проверки в агенте" sourceRef="IMAN_Set_Attention_Flag" targetRef="IMAN_Check_Program" />
    <sequenceFlow id="Flow_50" sourceRef="IMAN_Build_Refusal" targetRef="Gateway_Output_Merge" />
    <sequenceFlow id="Flow_51" sourceRef="Gateway_Output_Merge" targetRef="Build_Output_JSON" />
    <sequenceFlow id="Flow_52" sourceRef="Build_Output_JSON" targetRef="AIS_Save_EP" />
    <sequenceFlow id="Flow_53" sourceRef="AIS_Save_EP" targetRef="Employee_Review" />
    <sequenceFlow id="Flow_54" sourceRef="Employee_Review" targetRef="Gateway_Correction" />
    <sequenceFlow id="Flow_55" name="Нет" sourceRef="Gateway_Correction" targetRef="End_Processed" />
    <sequenceFlow id="Flow_56" name="Да" sourceRef="Gateway_Correction" targetRef="Employee_Edit_Request" />
    <sequenceFlow id="Flow_57" sourceRef="Employee_Edit_Request" targetRef="Resend_To_Agent" />
    <sequenceFlow id="Flow_58" name="Повторный запуск всех проверок" sourceRef="Resend_To_Agent" targetRef="Validate_Normalize_JSON" />

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Multichannel_Autoapproval">
    <bpmndi:BPMNPlane id="BPMNPlane_Multichannel_Autoapproval" bpmnElement="Process_Multichannel_Autoapproval">
      <bpmndi:BPMNShape id="Lane_Channels_di" bpmnElement="Lane_Channels" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="7960" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Orchestrator_di" bpmnElement="Lane_Orchestrator" isHorizontal="true">
        <dc:Bounds x="40" y="240" width="7960" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AIS_di" bpmnElement="Lane_AIS" isHorizontal="true">
        <dc:Bounds x="40" y="430" width="7960" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IngoRead_di" bpmnElement="Lane_IngoRead" isHorizontal="true">
        <dc:Bounds x="40" y="570" width="7960" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Oracle_di" bpmnElement="Lane_Oracle" isHorizontal="true">
        <dc:Bounds x="40" y="710" width="7960" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IMAN_di" bpmnElement="Lane_IMAN" isHorizontal="true">
        <dc:Bounds x="40" y="850" width="7960" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="40" y="1320" width="7960" height="170" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Request_di" bpmnElement="Start_Request">
        <dc:Bounds x="100" y="110" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="76" y="148" width="86" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Channel_di" bpmnElement="Gateway_Channel" isMarkerVisible="true">
        <dc:Bounds x="190" y="103" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="177" y="76" width="76" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receive_Mobile_di" bpmnElement="Receive_Mobile"><dc:Bounds x="300" y="50" width="200" height="55" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receive_Email_di" bpmnElement="Receive_Email"><dc:Bounds x="300" y="115" width="200" height="55" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receive_Integration_di" bpmnElement="Receive_Integration"><dc:Bounds x="300" y="180" width="200" height="55" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Documents_Merge_di" bpmnElement="Gateway_Documents_Merge" isMarkerVisible="true">
        <dc:Bounds x="560" y="100" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Send_To_IngoRead_di" bpmnElement="Send_To_IngoRead"><dc:Bounds x="670" y="275" width="200" height="65" /></bpmndi:BPMNShape>
